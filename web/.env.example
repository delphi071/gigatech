# Vercel Postgres / Neon 연결 문자열
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# 관리자 로그인 비밀번호 (임시 인증)
ADMIN_PASSWORD="change-me"
# 관리자 세션 서명 시크릿 (아무 긴 랜덤 문자열)
ADMIN_SECRET="please-change-this-to-a-long-random-string"

# 파일 첨부 저장 (Vercel Blob) - Vercel 프로젝트 연결 시 자동 주입
BLOB_READ_WRITE_TOKEN=""

# 메일 알림 (Resend)
RESEND_API_KEY=""
MAIL_TO="gigatech23@daum.net"
MAIL_FROM="noreply@gigatech.kr"
