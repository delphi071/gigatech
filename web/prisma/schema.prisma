generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// 설정(관리자 비밀번호 해시 등) key-value 저장
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// 고객문의
model Inquiry {
  id          Int      @id @default(autoincrement())
  company     String
  name        String
  phone       String
  email       String
  replyMethod String // phone | email | visit
  title       String
  content     String   @db.Text
  agreed      Boolean  @default(false)
  handled     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

/// 견적문의
model Quote {
  id               Int      @id @default(autoincrement())
  building         String
  manager          String
  phone            String
  email            String
  address          String?
  targetFacilities String[] // 대상설비(다중 선택)
  request          String?  @db.Text
  fileUrl          String?
  fileName         String?
  agreed           Boolean  @default(false)
  handled          Boolean  @default(false)
  createdAt        DateTime @default(now())
}
