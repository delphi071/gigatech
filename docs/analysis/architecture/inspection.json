{
  "texts": {
    "docs\\1.홈페이지 제작관련\\내부내용자료\\1.txt": {
      "encoding": "utf-8-sig",
      "lines": [
        {
          "line": 1,
          "text": "메뉴관련 변동사항입니다 "
        },
        {
          "line": 2,
          "text": ""
        },
        {
          "line": 3,
          "text": "상위메뉴 기계설비법 및 이하메뉴를"
        },
        {
          "line": 4,
          "text": "상위메뉴 주요업무 장비보유현황 사이로"
        },
        {
          "line": 5,
          "text": "이동요청드립니다"
        },
        {
          "line": 6,
          "text": ""
        },
        {
          "line": 7,
          "text": "실시간견적문의 하위메뉴를"
        },
        {
          "line": 8,
          "text": "카카오톡"
        },
        {
          "line": 9,
          "text": "온라인채팅연동 두탭으로 분리부탁드립니다"
        },
        {
          "line": 10,
          "text": ""
        },
        {
          "line": 11,
          "text": "고객문의 하위탭이름을"
        },
        {
          "line": 12,
          "text": "각각 고객문의 견적문의로 변경요청드립니다"
        },
        {
          "line": 13,
          "text": ""
        },
        {
          "line": 14,
          "text": "주요업무 하위메뉴"
        },
        {
          "line": 15,
          "text": "성능점검및 유지관리자 컨설팅을"
        },
        {
          "line": 16,
          "text": "기계설비 성능점검및 기계설비 유지관리점검으로"
        },
        {
          "line": 17,
          "text": "변경요청드립니다 "
        },
        {
          "line": 18,
          "text": ""
        },
        {
          "line": 19,
          "text": "이미지및 내용관련입니다"
        },
        {
          "line": 20,
          "text": ""
        },
        {
          "line": 21,
          "text": "메인페이지 성능점검칸 사진을 점검이미지로"
        },
        {
          "line": 22,
          "text": "변경요청드립니다 "
        },
        {
          "line": 23,
          "text": "하단 장비보유현황사진은 추후 장비보유사진전달시"
        },
        {
          "line": 24,
          "text": "수정해주시면될거같습니다 "
        },
        {
          "line": 25,
          "text": ""
        },
        {
          "line": 26,
          "text": "기타 조직도및 인증서 장비보유사진은"
        },
        {
          "line": 27,
          "text": "준비중입니다"
        },
        {
          "line": 28,
          "text": ""
        },
        {
          "line": 29,
          "text": "로고는 아직 준비중이며 로고가조금"
        },
        {
          "line": 30,
          "text": "시간이 걸릴예정입니다"
        }
      ]
    },
    "docs\\1.홈페이지 제작관련\\내부내용자료\\인사말.txt": {
      "encoding": "utf-8-sig",
      "lines": [
        {
          "line": 1,
          "text": "기계설비 성능점검 믿고 맡길 수 있는 기업, 주식회사 기가테크"
        },
        {
          "line": 2,
          "text": "저희 (주)기가테크는 기계설비성능점검, 성능점검, 기계설비, 전문업체로"
        },
        {
          "line": 3,
          "text": "고객 만족에 최선을 다하겠습니다."
        },
        {
          "line": 4,
          "text": "앞으로도 변함없는 고객 여러분들의 관심과 성원으로 더욱더 정진하여 보다 성심성의껏 우수한 품질의 서비스를 제공하고"
        },
        {
          "line": 5,
          "text": "여러분들의 발전에 기여할 수 있도록 최선을 다하겠습니다."
        },
        {
          "line": 6,
          "text": "앞으로도 고객님의 요구에 최선을 다할 것을 약속드리겠습니다."
        },
        {
          "line": 7,
          "text": "감사합니다."
        }
      ]
    },
    "docs\\1.홈페이지 제작관련\\홈페이지 수정자료\\요청사항.txt": {
      "encoding": "utf-8-sig",
      "lines": [
        {
          "line": 1,
          "text": "요청사항입니다"
